# Nhost project configuration
# Get these values from your Nhost dashboard: https://app.nhost.io
EXPO_PUBLIC_NHOST_SUBDOMAIN=your-subdomain
EXPO_PUBLIC_NHOST_REGION=us-west-2

# Set to 'true' to disable RxDB GraphQL replication (e.g., for E2E CI).
# For real Nhost sync, keep this as 'false'.
EXPO_PUBLIC_SKIP_SYNC=false

# Sentry DSN for error tracking (optional but recommended for production)
# Get it from: https://ismaelcruzvaca-arch.sentry.io/ (or your Sentry project settings)
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx

# Power BI Embedded Dashboard URL
# URL del dashboard de Power BI para el botón de reportes en Ajustes
EXPO_PUBLIC_POWERBI_URL=https://app.powerbi.com/your-dashboard-url
